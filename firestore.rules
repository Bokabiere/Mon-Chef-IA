rules_version = '2';

// À déployer via la console Firebase (Firestore Database > Règles) ou avec
// `firebase deploy --only firestore:rules`.
//
// Ceci est LE véritable rempart de sécurité de l'application : le code
// client (index.html) peut toujours être lu, modifié ou contourné par
// n'importe qui, donc il ne doit JAMAIS être la seule protection. Ces règles
// sont évaluées côté serveur Firebase et ne peuvent pas être contournées
// depuis le navigateur.
service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null && request.auth.token.email == "bokabiere@gmail.com";
    }

    match /utilisateurs/{userId} {
      // Un utilisateur connecté (y compris un visiteur anonyme de démo) 
      // peut lire et écrire uniquement ses propres données.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // L'admin peut tout lire et écrire
      allow read, write: if estAdmin();
      
      // Règles pour toutes les sous-collections de cet utilisateur (carnet, courses, planning, userData)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if estAdmin();
      }
    }

    match /config/{document=**} {
      // Tout utilisateur authentifié (même démo) doit pouvoir lire les ingrédients et clés API
      allow read: if request.auth != null;
      // Seul l'admin peut les modifier (ajouter des ingrédients etc.)
      allow write: if estAdmin();
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
